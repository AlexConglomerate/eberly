{
  "name": "eberly",
  "version": "0.3.1",
  "description": "Typed end-to-end API tests for any backend with an OpenAPI 3 spec",
  "keywords": [
    "openapi",
    "swagger",
    "e2e",
    "api-testing",
    "testing",
    "typescript",
    "client-generator",
    "vitest",
    "claude-code"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexConglomerate/eberly.git"
  },
  "homepage": "https://eberly.dev",
  "bugs": {
    "url": "https://github.com/AlexConglomerate/eberly/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "eberly": "bin/eberly.mjs"
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "clone/tests"
  ],
  "sideEffects": false,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsup index.ts --format cjs,esm --dts",
    "release": "pnpm run build && changeset publish",
    "prepublishOnly": "pnpm run build && tsx scripts/sync-template.ts",
    "lint": "tsc",
    "test": "tsx --test 'src/**/*.test.ts'",
    "e2e": "tsx scripts/e2e.ts",
    "stackblitz": "tsx scripts/stackblitz.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.26.0",
    "@types/node": "^25.8.0",
    "tsup": "^6.5.0",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
