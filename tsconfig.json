{
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    // tsup-овский dts-плагин (TS 6) внутренне выставляет deprecated baseUrl.
    "ignoreDeprecations": "6.0",
    "target": "es2022",
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    /* If NOT transpiling with TypeScript: */
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "noEmit": true,
    /* If your code runs in the DOM: */
    "lib": ["es2022", "dom", "dom.iterable"],
  },
  // Только библиотека. Примеры проверяются своими tsconfig: у Nest-примера
  // декораторы параметров (`@Body()`) под этим конфигом не скомпилируются.
  "include": ["index.ts", "src", "scripts"]
}
