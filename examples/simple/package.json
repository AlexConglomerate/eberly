    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "ebely": "workspace:*"
  },
  "devDependencies": {
    "@orpc/openapi": "^1.14.3",
    "@orpc/server": "^1.14.3",
    "@orpc/zod": "^1.14.3",
    "@types/node": "^25.8.0",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  }
}
