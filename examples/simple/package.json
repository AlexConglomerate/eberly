{
  "name": "@ebely-examples/simple",
  "version": "0.0.0",
  "private": true,
  "description": "Простой пример использования библиотеки ebely: тестовый бэкенд + сгенерированный типизированный клиент.",
  "type": "module",
  "scripts": {
    "backend:dev": "tsx watch test-backend/server.ts",
